function topos(aL, relativeY, statusMsg, keepStatus)
    pcall(function()
        if statusMsg then setRaidStatus(statusMsg) else setRaidStatus("Tweening") end
        local player = game:GetService("Players").LocalPlayer
        local character = player and player.Character
        local humanoid = character and character:FindFirstChild("Humanoid")
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        if not (player and character and humanoid and rootPart and humanoid.Health > 0) then
            if not keepStatus then setRaidStatus("Idle") end
            return
        end
        if humanoid.Sit then
            humanoid.Sit = false
        end
        if getgenv().currentTween then
            pcall(function() getgenv().currentTween:Cancel() end)
            getgenv().currentTween = nil
        end
        local DefaultY = (type(aL) == "table" and aL.Y) or (aL.Y or getgenv().ResumeY or 28)
        local targetPos = (aL.Position and aL.Position) or aL
        local Distance = (targetPos - rootPart.Position).Magnitude
        if Distance <= 200 then
            if relativeY then
                rootPart.CFrame = CFrame.new(targetPos.X, targetPos.Y + (getgenv().MobYOffset or getgenv().LockY or 28), targetPos.Z)
            else
                rootPart.CFrame = (type(aL) == "userdata" and aL) or CFrame.new(targetPos)
            end
            if not keepStatus then setRaidStatus("Idle") end
            return
        end
        local aM = nil
        if type(CheckNearestTeleporter) == "function" then
            aM = CheckNearestTeleporter(aL)
            if aM and type(requestEntrance) == "function" then
                pcall(function() requestEntrance(aM) end)
            end
        end
        local UpY = getgenv().TPUpY or 5000
        pcall(function()
            for i=1,3 do
                if not (rootPart and rootPart.Parent) then break end
                rootPart.CFrame = CFrame.new(rootPart.Position.X, UpY, rootPart.Position.Z)
                rootPart.AssemblyLinearVelocity = Vector3.new(0,0,0)
                rootPart.AssemblyAngularVelocity = Vector3.new(0,0,0)
                rootPart.Velocity = Vector3.new(0,0,0)
                task.wait(0.03)
            end
        end)
        local aboveTarget = CFrame.new((aL.X or targetPos.X), UpY, (aL.Z or targetPos.Z))
        local horizontalDistance = (aboveTarget.Position - rootPart.Position).Magnitude
        local TweenSpeed = getgenv().TweenSpeed or 350
        if Distance <= 400 then
            TweenSpeed = 400
        end
        local info1 = TweenInfo.new(math.max(horizontalDistance / TweenSpeed, 0.05), Enum.EasingStyle.Linear)
        if getgenv().currentTween then
            pcall(function() getgenv().currentTween:Cancel() end)
            getgenv().currentTween = nil
        end
        getgenv().currentTween = TweenService:Create(rootPart, info1, {CFrame = aboveTarget})
        getgenv().currentTween:Play()
        repeat
            task.wait(0.03)
            pcall(function()
                if rootPart then
                    rootPart.AssemblyLinearVelocity = Vector3.new(0,0,0)
                    rootPart.AssemblyAngularVelocity = Vector3.new(0,0,0)
                    rootPart.Velocity = Vector3.new(0,0,0)
                end
            end)
        until not getgenv().currentTween or getgenv().currentTween.PlaybackState == Enum.PlaybackState.Completed
        if getgenv().currentTween then
            pcall(function() getgenv().currentTween:Wait() end)
        end
        getgenv().currentTween = nil
        local descendY = DefaultY + 1
        pcall(function()
            rootPart.CFrame = CFrame.new((aL.X or targetPos.X), descendY, (aL.Z or targetPos.Z))
        end)
        task.wait(0.03)
        pcall(function()
            if relativeY then
                rootPart.CFrame = CFrame.new((targetPos.X), (targetPos.Y + (getgenv().MobYOffset or getgenv().LockY or 28)), (targetPos.Z))
            else
                rootPart.CFrame = (type(aL) == "userdata" and aL) or CFrame.new(targetPos)
            end
        end)
        if not keepStatus then setRaidStatus("Idle") end
    end)
end
