local function normalizeKey(key)
    if not key then return nil end
    key = tostring(key):gsub("%s+", "")
    local up = string.upper(key)
    if up == "TAP" or up == "TAPHOLD" then
        return "TAP"
    end
    for _, k in ipairs({"Z","F","X","C","V"}) do
        if up == k then
            return k
        end
    end
    return nil
end
local function GetDoughInfo()
    local raw = k34()
    local have = {}
    for key in string.gmatch(raw, "[^,%s]+") do
        local norm = normalizeKey(key)
        if norm then
            have[norm] = true
        end
    end
    local awakenedList = {}
    local missingList  = {}
    for _, key in ipairs(doughOrder) do
        if have[key] then
            table.insert(awakenedList, key)
        else
            table.insert(missingList, key)
        end
    end
    return { raw = raw, have = have, awakenedList = awakenedList, missingList = missingList, count = #awakenedList, total = #doughOrder }
end
