local function GetFruitPrice(name)
    if typeof(fruitsInfo) ~= "table" then return 0 end
    if fruitsInfo[name] and fruitsInfo[name].Price then
        return fruitsInfo[name].Price
    end
    for _, v in pairs(fruitsInfo) do
        if typeof(v) == "table" then
            if (v.Name == name or v[1] == name) and v.Price then
                return v.Price
            end
        end
    end
    return 0
end
local function extractFruitNameFromTool(tool)
    if not tool then return nil end
    local original = tool:GetAttribute("OriginalName")
    if original and type(original) == "string" and #original > 0 then
        return original
    end
    local s = tostring(tool.Name or "")
    if s == "" then return nil end
    s = s:gsub("%s*[Ff]ruit%s$", "")
    s = s:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
    local candidates = { s, s:gsub(" ", "-"), s:gsub(":", ": "), s:gsub(":  ", ": ") }
    if typeof(fruitsInfo) == "table" then
        for _, c in ipairs(candidates) do
            if fruitsInfo[c] then
                return c
            end
        end
        for _, v in pairs(fruitsInfo) do
            if typeof(v) == "table" then
                local vn = v.Name or v[1]
                if vn then
                    for _, c in ipairs(candidates) do
                        if tostring(vn) == tostring(c) then
                            return tostring(vn)
                        end
                    end
                end
            end
        end
    end
    return nil
end
