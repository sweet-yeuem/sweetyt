local function parsePrice(val)
    if not val then return 0 end
    local s = tostring(val)
    s = s:gsub(",", ""):lower():gsub("%s+", "")
    local mult = 1
    if s:match("k") then
        s = s:gsub("k", "")
        mult = 1000
    elseif s:match("m") then
        s = s:gsub("m", "")
        mult = 1000000
    end
    local num = tonumber(s) or 0
    return num * mult
end
