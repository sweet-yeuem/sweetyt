        end)
    else
        if not CheckItemBPCR("Special Microchip") then rep.Remotes.CommF_:InvokeServer("RaidsNpc", "Select", "Dough") return end
        if Second_Sea then
            if calcpos(Vector3.new(-6459.41748046875, 306.11492919921875, -4742.63671875)) >= 500 then
