function GetMirror()
    if CheckInvAmount("Conjured Cocoa") < 10 then
        if CheckMon("Chocolate Bar Battler") then
            v = CheckMon("Chocolate Bar Battler")
            repeat task.wait() KillMon(v.Name, true) until not v or not v:FindFirstChild("HumanoidRootPart") or not v:FindFirstChild("Humanoid") or v.Humanoid.Health <= 0 or TaskCurrently ~= "Get Mirror Fractal"
        else
            Tween(CFrame.new(744.7930908203125, 24.76934242248535, -12637.7255859375))
        end
    else
        if not CheckItemBPCR("God's Chalice") then
            EliteEnemies = {"Diablo", "Urban", "Deandre"}
            if not plr.PlayerGui.Main.Quest.Visible then rep.Remotes.CommF_:InvokeServer("EliteHunter") end
            if CheckMon(EliteEnemies, true) then
                v = CheckMon(EliteEnemies, true)
                repeat task.wait()
                    KillMon(v.Name, false)
                until not v or not v:FindFirstChild("HumanoidRootPart") or not v:FindFirstChild("Humanoid") or v.Humanoid.Health <= 0
            else
                loadstring(game:HttpGet("https://raw.githubusercontent.com/fI0ntium/tatcadeucomeo/refs/heads/main/Hop.lua"))()
            end
        else
            FarmKata()
        end
    end
end

