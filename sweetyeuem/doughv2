end
local function findToolInContainer(container, weaponList)
    for _, tool in ipairs(container:GetChildren()) do
        if tool:IsA("Tool") then
            local tip = tostring(tool.ToolTip or "")
            local name = tostring(tool.Name or "")
            for _, wn in ipairs(weaponList) do
                local wn_l = tostring(wn):lower()
                if string.find(name:lower(), wn_l) or (tip ~= "" and string.find(tip:lower(), wn_l)) then
                    return tool
                end
            end
        end
    end
    return nil
end
local function findToolAnywhere(weaponList)
    local searchContainers = {LocalPlayer.Character, LocalPlayer.Backpack, game:GetService("StarterPack"), RS, Workspace}
    for _, cont in ipairs(searchContainers) do
        if cont and cont.GetChildren then
            local found = findToolInContainer(cont, weaponList)
            if found then return found end
        end
    end
    for _, cont in ipairs({LocalPlayer.Backpack, LocalPlayer.Character}) do
        if cont and cont.GetChildren then
            for _, tool in ipairs(cont:GetChildren()) do
                if tool:IsA("Tool") then
                    return tool
                end
            end
        end
    end
    return nil
end
local function EquipMelee()
    setRaidStatus("Equipping melee")
    local weaponList = getgenv().MeleeNames or {"Melee"}
    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not humanoid then
        setRaidStatus("Idle")
        return
    end
    local current = char:FindFirstChildOfClass("Tool")
    if current then
        for _, name in ipairs(weaponList) do
            if string.find(current.Name:lower(), tostring(name):lower()) then
                getgenv().LastEquippedTool = current
                setRaidStatus("Equipped melee")
                return
            end
        end
    end
    local tool = findToolAnywhere(weaponList)
    if not tool then
        setRaidStatus("Idle")
        return
    end
    if tool == current and tool.Parent == char then
        getgenv().LastEquippedTool = tool
        setRaidStatus("Equipped melee")
        return
    end
    if getgenv().LastEquippedTool == tool and (tick() - (getgenv().LastEquipTime or 0) < 0.8) then
        setRaidStatus("Idle")
        return
    end
    pcall(function()
        if tool.Parent ~= LocalPlayer.Backpack and tool.Parent ~= char then
            tool.Parent = LocalPlayer.Backpack
            task.wait(0.12)
        end
        humanoid:EquipTool(tool)
        getgenv().LastEquippedTool = tool
        getgenv().LastEquipTime = tick()
        task.wait(0.15)
    end)
    setRaidStatus("Equipped melee")
end
local function attackKillAura(radius)
    if not getgenv().KillAura then return end
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp or not Workspace:FindFirstChild("Enemies") then return end
    for _, v in ipairs(Workspace.Enemies:GetChildren()) do
        local eHRP = v:FindFirstChild("HumanoidRootPart")
        local eHum = v:FindFirstChildOfClass("Humanoid") or v:FindFirstChild("Humanoid")
        if eHRP and eHum and eHum.Health > 2 then
            if (eHRP.Position - hrp.Position).Magnitude <= radius then
                pcall(function()
                    local dmg = math.max(1, math.floor(eHum.Health * 0.05))
                    if eHum.Health - dmg <= 1 then
                        dmg = math.max(1, math.floor((eHum.Health - 2) / 2))
                    end
                    if dmg > 0 and eHum.Health > dmg + 1 then
                        eHum:TakeDamage(dmg)
                    end
                end)
            end
        end
    end
end
local function nearestEnemy()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp or not Workspace:FindFirstChild("Enemies") then return nil end
    local best, bestDist = nil, math.huge
    for _, enemy in pairs(Workspace.Enemies:GetChildren()) do
        local eHRP = enemy:FindFirstChild("HumanoidRootPart")
        local eHum = enemy:FindFirstChildOfClass("Humanoid") or enemy:FindFirstChild("Humanoid")
        if eHRP and eHum and eHum.Health and eHum.Health > 0 and enemy.Parent ~= nil then
            local d = (eHRP.Position - hrp.Position).Magnitude
            if d < bestDist then
                bestDist = d
                best = enemy
            end
        end
    end
    return best, bestDist
end
