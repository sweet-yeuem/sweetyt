function CheckItemBPCR(name)
    chbp = {plr.Character,plr.Backpack}
    for i, v in pairs(chbp) do
        if v:FindFirstChild(name) then
            return v:FindFirstChild(name)
        end
    end
end
function calcpos(p1,p2)
    p2 = p2 or plr.Character.HumanoidRootPart.Position
    return (p1 - p2).Magnitude
end
function CheckItemInv(m)
    for _,v in next, rep.Remotes.CommF_:InvokeServer("getInventory") do
        if v.Name == m then
            return m
        end
