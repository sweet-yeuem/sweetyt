        if not (eHRP and eHum and eHum.Health > 0) then return end
        local radius = 45
        LockVelocity(true)
        local isl = getNextIsland()
        local islName = isl and isl.Name or "unknown"
        local islNum = isl and tonumber(isl.Name:match("%d+")) or nil
        if islNum then
            setRaidStatus("Killing mob: "..tostring(islName).." (island: "..tostring(islNum).."/5)")
        else
            setRaidStatus("Killing mob: "..tostring(islName).." (island: unknown/5)")
        end
        local startTick = tick()
        local angle = 0
        local steps = 16
        local stepDelay = 0.06
        while true do
            if not enemy or not enemy.Parent then break end
            eHum = enemy:FindFirstChildOfClass("Humanoid") or enemy:FindFirstChild("Humanoid")
            eHRP = enemy:FindFirstChild("HumanoidRootPart")
            if not eHum or eHum.Health <= 0 or not eHRP then break end
            local center = eHRP.Position
            for i=1,steps do
                if not enemy or not enemy.Parent then break end
                eHum = enemy:FindFirstChildOfClass("Humanoid") or enemy:FindFirstChild("Humanoid")
                eHRP = enemy:FindFirstChild("HumanoidRootPart")
                if not eHum or eHum.Health <= 0 or not eHRP then break end
                angle = angle + (2*math.pi)/steps
                local px = center.X + radius * math.cos(angle)
                local pz = center.Z + radius * math.sin(angle)
                local py = center.Y + (getgenv().MobYOffset or getgenv().LockY or 28)
                topos(CFrame.new(px, py, pz), true, "Killing mob...", true)
                local waitStart = tick()
                while tick() - waitStart < (stepDelay + 0.02) do
                    task.wait(0.03)
                    if not enemy or not enemy.Parent then break end
                    eHum = enemy:FindFirstChildOfClass("Humanoid") or enemy:FindFirstChild("Humanoid")
                    if not eHum or eHum.Health <= 0 then break end
                end
                if getgenv().KillAura then
                    LockVelocity(false)
                    setRaidStatus("Idle")
                    return
                end
            end
            if tick() - startTick > 12 then
                break
            end
        end
        LockVelocity(false)
        setRaidStatus("Idle")
    end)
end

