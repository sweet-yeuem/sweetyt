function CheckIslandRaid(v6)
    if workspace["_WorldOrigin"].Locations:FindFirstChild("Island " .. v6) then
        Min = 4500
        for r,v in pairs(workspace["_WorldOrigin"].Locations:GetChildren()) do
            if v.Name == "Island " .. v6 and calcpos(v.Position) < Min then
                Min = calcpos(v.Position)
            end
        end
        for r,v in pairs(workspace["_WorldOrigin"].Locations:GetChildren()) do
            if v.Name == "Island " .. v6 and calcpos(v.Position) <= Min then
                return v
            end
        end
    end
end

function NextIsland()
    TableIslandsRaid = {5, 4, 3, 2, 1}
    for r,v in pairs(TableIslandsRaid) do
        if CheckIslandRaid(v) and calcpos(CheckIslandRaid(v).Position) <= 4500 then
            return CheckIslandRaid(v)
        end
    end
end

function CheckIsRaiding()
    Timer = plr.PlayerGui.Main.Timer.Visible == true
    Island = NextIsland()
    if Timer then
        return Timer
    end
    return Island
end
function Kill_Aura()
    for i,v in pairs(workspace.Enemies:GetDescendants()) do
        if DetectingPart(v) and v.Humanoid.Health > 0 then
            repeat wait()
                KillMon(v.Name, false)
            until NotAlive(v) or not TaskCurrently ~= "Auto Raid"
        end
    end
end

function AutoRaid()
