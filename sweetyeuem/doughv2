end

CheckInvAmount = function(name)
    for i, v in pairs(rep.Remotes["CommF_"]:InvokeServer("getInventory")) do
        if v.Type == "Material" and v.Name == name then
            return v.Count
        end
    end
    return 0
end

TaskCurrently = ""
